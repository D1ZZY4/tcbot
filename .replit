modules = ["nix", "python-3.14", "nodejs-24"]

[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["uv", "nano", "gnupg", "gcc-unwrapped"]

[env]
LD_LIBRARY_PATH = "/nix/store/bmi5znnqk4kg2grkrhk6py0irc8phf6l-gcc-14.2.1.20250322-lib/lib"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Application"

[[workflows.workflow]]
name = "Start Application"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run python -m tcbot"

[[ports]]
localPort = 5098
externalPort = 3000

[[ports]]
localPort = 5099
externalPort = 3002

[[ports]]
localPort = 5432
externalPort = 3001
exposeLocalhost = true

[[ports]]
localPort = 8080
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["uv", "run", "python", "-m", "tcbot"]
