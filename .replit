modules = ["nix", "python-3.14", "nodejs-24"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["openssl", "uv", "nano", "gnupg"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Application"

[[workflows.workflow]]
name = "Start Application"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run python -m tcbot"

[[ports]]
localPort = 8080
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["uv", "run", "python", "-m", "tcbot"]

[objectStorage]
defaultBucketID = "replit-objstore-8e8d8179-ca33-440f-b356-711aeb984f5d"
