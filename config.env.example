## -- Remove this line after filling in your values --

# ───────────────────────── Core identity ───────────────────────── #

BOT_TOKEN = ""
## Telegram bot token from @BotFather. Required.
## eg: "7123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

OWNER_ID = ""
## Numeric Telegram user ID of the initial Owner. Required.
## eg: "123456789"

COMMUNITY_NAME = ""
## Display name used in bot messages and log headers.
## Empty uses the code default "Bot".
## eg: "TCF - Transsion Core Federation"

# ───────────────────────── Transport ───────────────────────── #

PREFIXES = ["/", "!", "."]
## Accepted command prefixes. Python list, tuple, or comma-separated values.
## Defaults to ["/", "!", "."].

PORT = "5000"
## Flask keep-alive port, 1-65535. Blank and invalid values use 5000.
## Compose maps this same value from the host, so keep it numeric there.

BIND_HOST = "0.0.0.0"
## Health server listener. Use 127.0.0.1 behind a local reverse proxy.

KURIGRAM_WORKERS = 0
## Dispatcher worker count. 0 sizes from CPU count and the database pool, capped at 64.

API_ID = ""
## Telegram API ID for MTProto identity lookups. Boot refuses a missing value.

API_HASH = ""
## Telegram API hash matching API_ID. Boot refuses a missing value.

MTPROTO_SESSION = "tcbot_mtproto"
## Namespace for the shared MTProto session in PostgreSQL.

SENTRY_DSN = ""
## Optional Sentry DSN for error monitoring. Empty disables monitoring.

LOG_LEVEL = INFO
## NOTSET, DEBUG, INFO, WARNING, WARN, ERROR, CRITICAL, or FATAL. Default: INFO.

# The bot uses Kurigram's native long polling. No webhook URL, secret,
# public endpoint, or TLS certificate is required or supported.

# ───────────────────────── Database and cache ───────────────────────── #

DATABASE_URL = ""
## PostgreSQL connection string. Required. The bot applies migrations at startup.
## eg: "postgresql://username:password@host:5432/tcbot"

DB_SCHEMA = "public"
## Schema the bot reads and writes. Only "public", "test", and "development" are
## accepted; any other value falls back to "public".

DB_POOL_SIZE = 5
## PostgreSQL pool size. Minimum 1. Default 5.

DB_MAX_OVERFLOW = 5
## Extra connections under load. Minimum 0. Default 5.

PG_CRON_ENABLED = false
## Let pg_cron own the pure-database maintenance jobs when the extension exists.

REDIS_URL = ""
## Optional Redis L2 cache URL. Empty uses the in-process L1 cache only.

# ───────────────────────── Chat destinations ───────────────────────── #

MAIN_GROUP = ""
## Main community group or forum chat ID. Negative only.

MAIN_CHANNEL = ""
## Main community channel chat ID, used for the community menu link and treated
## as a deployment-owned destination. Negative only.

PROOFS = ""
## Required ban-proof destination: a negative group or channel chat ID.
## Accepts chat_id or chat_id/thread_id.

LOGS = ""
## Federation audit-log destination, chat_id or chat_id/thread_id.

LOGS_ERRORS = ""
## Error-report destination. Empty falls back to the Owner DM.

APPEALS = ""
## Appeal record and review-card destination, chat_id or chat_id/thread_id.

INFRA_CHAT_IDS = []
## Extra deployment-owned chat IDs refused by the connect paths. Negative only.
## Accepts a list, tuple, or CSV.

# ───────────────────────── Moderation policy ───────────────────────── #

WARN_LIMIT = 3
## Per-group warns that trigger an automatic federation ban. Minimum 1.

FED_WARN_LIMIT = 0
## Federation-wide warn threshold. 0 disables it.

WARN_EXPIRY_DAYS = 0
## Days after which a warning stops counting. 0 disables expiry; history is kept.

ALBUM_DEBOUNCE_SECONDS = 4
## Proof silence window before execution. Minimum 1; proof collection is
## separately capped at 60 seconds.

PROMOTION_REQUEST_TTL_DAYS = 7
## Days a pending promotion request stays open. 0 disables expiry.

# ───────────────────────── Module filters ───────────────────────── #

MODULES_LOAD = ""
## Allowlist of module filenames. Empty loads all discovered modules.

MODULES_NO_LOAD = ""
## Denylist of module filenames. Applied after the allowlist.

# ───────────────────────── Integration tests ───────────────────────── #

TCBOT_TEST_DATABASE_URL = ""
## Dedicated PostgreSQL URL for the postgres-marked tests. Unset skips them.
## Never use the deployment database.

TCBOT_TEST_REDIS_URL = ""
## Dedicated Redis URL for the integration tests. Unset skips them.
## Never use the deployment cache.

# ───────────────────────── Docker Compose only ───────────────────────── #

POSTGRES_USER = "tcbot"
POSTGRES_PASSWORD = ""
POSTGRES_DB = "tcbot"
## The local Compose PostgreSQL service needs POSTGRES_PASSWORD.
## The bot reads DATABASE_URL, never these values.
