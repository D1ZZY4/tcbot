## -- Remove this line after filling in your values --

BOT_TOKEN = ""
## Your Telegram bot token. Get it from @BotFather on Telegram.
## eg: "7123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

OWNER_ID = ""
## Your Telegram user ID (numeric). Get it from @userinfobot or @getidsbot.
## This user has full owner-level access to the bot.
## eg: "123456789"

DATABASE_URL = ""
## Your PostgreSQL connection string. The bot applies its schema migrations
## at startup, so the database must be reachable and the user must be able
## to create tables.
## eg: "postgresql://username:password@host:5432/tcbot"

DB_SCHEMA = "public"
## The PostgreSQL schema the bot reads and writes. The project uses three
## schemas and no more: "public" for the deployment, "test" for the
## integration tests, and "development" for a developer working against a
## shared server. A schema that does not exist yet is created at startup,
## so a fresh deployment comes up empty and a mistyped name never sends
## the schema objects into another schema.
## Default: "public".
## eg: "public" or "development"

REDIS_URL = ""
## (Optional) Redis connection URL for distributed caching across bot restarts.
## When set, role / connection / groups / owner caches use Redis as L2 storage.
## hiredis C extension is auto-used when installed (already in pyproject.toml).
## eg: "redis://localhost:6379" or "redis://:password@host:6379/0"
## Leave empty to use in-memory caching only (single-process default).

DB_POOL_SIZE = 5
## Size of the PostgreSQL connection pool.
## The pool must fit the number of connections the database grants this
## user. A pooler in transaction or session mode caps it at a small
## number, and a pool that is larger than the cap does not fail at
## startup: it fails later as a "max clients reached" refusal on every
## call that needs a connection, which the circuit breaker reads as a
## database outage. Raise it only when the database grants more.
## Minimum 1. Default 5.

DB_MAX_OVERFLOW = 5
## Extra connections the pool may open beyond DB_POOL_SIZE under load.
## These connections are closed again when the load drops, so a high
## value only helps a burst that is short. Keep the total (DB_POOL_SIZE
## + DB_MAX_OVERFLOW) within the connection limit of the database.
## Minimum 0. Default 5.

COMMUNITY_NAME = ""
## Display name of your federation / community. Used in bot messages and log headers.
## Leave empty to use the code default "Bot".
## eg: "TCF - Transsion Core Federation"

PREFIXES = ["/", "!", "."]
## List of command prefixes the bot will recognize.
## Must be a Python-style list. Defaults to ["/", "!", "."] if not set.
## eg: ["/", "!"] or ["/", ".", "!"]

PORT = "5000"
## Port for the Flask keep-alive / health-check server.
## Set to a number between 1 and 65535 to use a specific port.
## "auto" or any invalid/empty value silently defaults to 5000.
## Set to the port your hosting platform expects (e.g. 8080 on Replit).
## eg: "5000" or "8080"

MAIN_GROUP = ""
## Chat ID of your main community group or forum (supergroup).
## Must be a negative number.
## eg: "-1001234567890"

COMMUNITY_GROUP_URL = "https://t.me/TranssionCoreFederationGroup"
## (Optional) Public URL of the main community discussion group,
## shown as the Discussion button in the Additional menu.
## Leave empty to use the built-in default above.
## eg: "https://t.me/TranssionCoreFederationGroup"

PROOFS = "-1003997518221"
## Where ban proof media is uploaded to after a /tcban is issued.
## Defaults to the community proof channel (-1003997518221); override with a
## chat ID or forum thread as chat_id/thread_id.
## eg: "-1001234567890" or "-1001234567890/67"

LOGS = ""
## Where ban / unban / appeal / admin action log messages are sent.
## Use a standalone channel/group chat ID, or a forum thread as chat_id/thread_id.
## eg: "-1001234567890" or "-1001234567890/42"

LOGS_ERRORS = ""
## Separate destination for error-level log messages.
## Same format as LOGS. When empty, reports fall back to the owner DM
## instead of being dropped; set it to receive error reports in a channel.
## eg: "-1001234567890/279"

APPEALS = ""
## Where submitted appeal messages are forwarded for record-keeping.
## Use a standalone channel, group, or forum thread as chat_id or
## chat_id/thread_id. The same destination also receives a copy of every
## review card, so one value covers all appeal surfaces.
## eg: "-1001234567890" or "-1001234567890/12"

ALBUM_DEBOUNCE_SECONDS = 4
## Silence window (in seconds) before collected proof executes. Album parts
## and sequential sends accumulate into one proof session; the ban executor
## runs when nothing new arrives for this long, when the moderator taps
## Done, or after a 60 s collection cap. Larger values tolerate slow
## networks but delay every execution by up to the window.
## Default: 4 seconds.

API_ID = ""
## Telegram API ID for MTProto identity lookups. REQUIRED: the bot refuses
## to boot without it. Get it at https://my.telegram.org.
## Never commit the real value.

API_HASH = ""
## Telegram API hash matching API_ID. REQUIRED together with API_ID.

MTPROTO_SESSION = "tcbot_mtproto"
## Namespace for the shared MTProto session in PostgreSQL. Default: tcbot_mtproto.

WARN_LIMIT = 3
## Per-group warning threshold that triggers an automatic federation ban.
## When a user's warn count in a single group reaches or exceeds this value,
## they are federation-banned and their warns in that group are cleared.
## Uses >= deliberately: after a total enforcement failure the count still
## equals the limit and the next warn must re-fire the auto-ban.
## Minimum 1. Default 3.

FED_WARN_LIMIT = 0
## Federation-wide warn threshold that triggers an automatic federation ban.
## When a user accumulates this many warnings across ALL connected groups combined,
## they are federation-banned even if no single group reached WARN_LIMIT.
## Set to 0 (default) to disable cross-group enforcement and rely only on the
## per-group WARN_LIMIT threshold. A value of 5-6 is a reasonable starting point
## for a 10+ group federation where WARN_LIMIT is 3.

LOG_LEVEL = INFO
## Log verbosity for the bot's own logger.
## Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
## Use DEBUG during development to see verbose internal output.
## Default: INFO

SENTRY_DSN = ""
## Optional Sentry DSN for production error monitoring (observability extra).
## Leave empty to disable; nothing ships unless you set it.

MODULES_LOAD = ""
## (Optional) Comma-separated list of module filenames to load exclusively (allowlist).
## When set, ONLY these modules are loaded - everything else is skipped.
## Leave empty to load all available modules.
## eg: "bans,appeals,admins"

MODULES_NO_LOAD = ""
## (Optional) Comma-separated list of module filenames to skip entirely (denylist).
## These modules will not be loaded. Has no effect when MODULES_LOAD is set.
## eg: "maintenance,broadcast"

WARN_EXPIRY_DAYS = 0
## (Optional) Number of days after which warn_count records are deleted.
## 0 = disabled (warn counts never expire automatically).
## When > 0, APScheduler runs a daily job to clean up old warn_counts entries.
## eg: 30 (expire warns after 30 days) or 90 (expire after 3 months)

WEBHOOK_URL = ""
## (Optional) Public base URL for the webhook endpoint.
## When set, the bot registers set_webhook() with Telegram and receives updates
## via POST /webhook instead of long-polling.
## On Replit this is auto-detected from REPLIT_DEV_DOMAIN, but only when the
## bot runs as the Replit application itself. A workspace shell that starts
## the bot by hand ignores the dev domain and polls instead, because the
## dev domain points at the Replit workflow and not at that shell.
## Set this value to use a webhook from anywhere else.
## For VPS or other hosting, set this to your HTTPS domain.
## Leave empty for local development; the bot falls back to long-polling.
## eg: "https://mybotdomain.example.com"

WEBHOOK_SECRET = ""
## (Optional) Secret token sent by Telegram in X-Telegram-Bot-Api-Secret-Token.
## When set, this value is used as-is. When empty, a random 64-char hex token is
## generated at startup (changes every restart; safe because set_webhook is always
## called with the current token).
## REQUIRED on Vercel: serverless instances cannot re-register the webhook on
## every cold start, so a generated token would never match Telegram's copy and
## /api/webhook would reject every update. Always set an explicit value there.
## eg: "my-very-long-random-secret-token-here"

CRON_SECRET = ""
## (Optional) Bearer token protecting the serverless cron endpoint (/api/cron).
## Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>` when set on the
## project. When empty the endpoint refuses every request (fail closed), so set
## it to enable the scheduled expiry run.
## eg: "another-long-random-secret-token-here"

COMMUNITY_CHANNEL_URL = "https://t.me/TranssionCoreFederation"
## (Optional) Public URL of the main community channel shown in the Additional Links menu.
## Leave empty to use the built-in default above.
## eg: "https://t.me/TranssionCoreFederation"

COMMUNITY_LOGS_URL = "https://t.me/TranssionCoreFederationLogs"
## (Optional) Public URL of the logs channel.
## Leave empty to use the built-in default above.
## eg: "https://t.me/TranssionCoreFederationLogs"

COMMUNITY_APPEAL_URL = "https://t.me/TranssionCoreFederationAppeals"
## (Optional) Public URL or invite link of the appeals channel.
## Leave empty to use the built-in default above.
## eg: "https://t.me/TranssionCoreFederationAppeals"
