# Secrets and credentials (never commit)
# Runtime tokens, URIs, and session material stay out of version control.
*.env
.env
config.env
config.env.local
config.env.development
config.env.backup
!config.env.example

# MTProto sessions (auth secrets)
*.session
*.session-journal

# Exported GPG keys (private key material)
gpg-key-backup/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Virtual environments
venv/
.venv/
.pythonlibs/

# Dependency lockfile is canonical; the legacy requirements file is unused.
requirements.txt

# Coverage and test artifacts (local runs and CI reports)
.coverage
.coverage.*
htmlcov/
coverage.xml
.pytest_cache/
.hypothesis/

# Tool caches
.cache/
.ruff_cache/

# Local operator state (one-shot migration resume file)
proof_migration_state.json
proof_migration_state.json.tmp

# Build outputs
dist/
build/

# Editors and OS files
.idea/
.DS_Store
Thumbs.db

# Logs and scratch notes
logs*/
check.log
format.log
nothing.md
nothing-*.md
account*
replit.nix
TCBOT_*.md

# Platform assets and local config
attached_assets/
/.config/

# Local agent skills (never versioned)
context7-expert/
copywriting-expert/
create-readme-expert/
commit-expert/
mermaid-diagrams-expert/
redis-expert/
deep-research-expert/
